class Heartbeat:
    """Print elapsed time to stderr every ~interval seconds while a long MCP call
    blocks. A backgrounded run buffers stdout until the call returns, so without
    this the terminal looks hung. Elapsed only — it never calls MCP (that would
    serialise behind the in-flight call on the single-instance server)."""

    def __init__(self, phase, interval=5.0):
        self.phase = phase
        self.interval = interval
        self._stop = threading.Event()
        self._thread = None
        self._start = 0.0

    def __enter__(self):
        self._start = time.monotonic()
        self._thread = threading.Thread(target=self._run, daemon=True)
        self._thread.start()
        return self

    def _run(self):
        while not self._stop.wait(self.interval):
            print(f"[doctor] {self.phase} … {time.monotonic() - self._start:.0f}s",
                  file=sys.stderr, flush=True)

    def __exit__(self, *exc):
        self._stop.set()
        if self._thread:
            self._thread.join(timeout=1)
        return False


class Report:
    """The only thing this script ever writes, and only when given a path. Two files:
    a .jsonl of every [doctor:*] record (structured, replayable, one object per line)
    and a markdown summary laid out like the skill's "what to report back" section.

    It also absorbs the bulk output — the relayed Maven log and the batch reports — so
    the terminal keeps the summary and the status instead of 758 Kb of scrollback."""

    def __init__(self, path):
        base, ext = os.path.splitext(path)
        self.md_path = path if ext else path + ".md"
        self.jsonl_path = base + ".jsonl"
        self.records = []
        self.bulk = []          # (title, text)

    def record(self, entry):
        self.records.append(entry)

    def section(self, title, text):
        self.bulk.append((title, text))

    def write(self, snap, args):
        with open(self.jsonl_path, "w", encoding="utf-8") as f:
            for entry in self.records:
                f.write(json.dumps(entry, ensure_ascii=False) + "\n")
        with open(self.md_path, "w", encoding="utf-8") as f:
            f.write(self._markdown(snap, args))

    def _markdown(self, snap, args):
        run = self._first("run") or {}
        end = self._first("end") or {}
        out = []
        out.append(f"# Doctor — {run.get('branch', '(branche inconnue)')}\n")
        out.append("## Chiffres\n")
        before = end.get("errors_before", run.get("errors", 0))
        after = end.get("errors_after", snap.error_count)
        out.append(f"- erreurs : **{before} → {after}**")
        out.append(f"- réparées mécaniquement : **{end.get('decided_errors', 0)}**")
        out.append(f"- rendues : **{end.get('handoff_errors', 0)}** sur"
                   f" **{end.get('handoff_projects', 0)}** projet(s)")
        if end.get("guarded_errors"):
            out.append(f"- rendues mais expliquées : **{end.get('guarded_errors')}**")
        out.append(f"- passes : {end.get('passes', 1)} | mode :"
                   f" {'apply' if args.apply else 'diagnostic'} | script {SCRIPT_VERSION}"
                   f" | plugin {run.get('plugin', '?')}")
        out.append(f"- workspace au repos à la lecture : {snap.settled} ({snap.settle_rounds} tour(s))\n")

        out.append("## Comptabilité par passe\n")
        passes = self._all("pass")
        if not passes:
            out.append("_Aucune passe (0 erreur)._\n")
        else:
            out.append("| passe | avant | après | attribué | non attribué | révélé | induit |"
                       " aveugle | verdict |")
            out.append("|---|---|---|---|---|---|---|---|---|")
            for entry in passes:
                out.append(f"| {entry.get('pass')} | {entry.get('errors_before')} |"
                           f" {entry.get('errors_after')} | {entry.get('attributed')} |"
                           f" {entry.get('unattributed')} | {entry.get('revealed', '')} |"
                           f" {entry.get('induced', '')} | {entry.get('blind', '')} |"
                           f" {entry.get('verdict', '')} |")
            out.append("\nUn `attribué` différent du delta signifie que la comptabilité est fausse :"
                       " le dire, pas recopier les chiffres. `induit` = erreurs apparues sur des"
                       " projets en aval de ce que la passe a touché : le prix du remède, pas une"
                       " régression.\n")

        out.append("## Décisions et verdicts\n")
        outcomes = self._all("outcome")
        if not outcomes:
            out.append("_Aucune décision._\n")
        else:
            out.append("| passe | remède | cible | fait | avant | après | verdict |")
            out.append("|---|---|---|---|---|---|---|")
            for entry in outcomes:
                out.append(f"| {entry.get('pass')} | {entry.get('remedy')} | {entry.get('target')} |"
                           f" {entry.get('facts', '')} | {entry.get('errors_before')} |"
                           f" {entry.get('errors_after')} | {entry.get('verdict')} |")
            out.append("")

        out.append("## Cas non classés — intégralité\n")
        total = self._first("handoff-total") or {}
        out.append(f"{total.get('errors', 0)} erreur(s) sur {total.get('projects', 0)} projet(s)"
                   f" — familles : {total.get('kinds', '(aucune)')}\n")
        out.append("| projet | erreurs | problem_kind | forme du message |")
        out.append("|---|---|---|---|")
        for entry in self._all("handoff"):
            shape = str(entry.get("shape", "")).replace("|", "\\|")
            out.append(f"| {entry.get('project')} | {entry.get('errors')} |"
                       f" {entry.get('problem_kind', '')} | {shape} |")
        out.append("")

        unresolved = self._all("unresolved")
        if unresolved:
            # The same name is emitted every pass it is still unresolved in — one row
            # per pass duplicated the whole table instead of showing what changed. Only
            # the latest pass's row is kept; "passe" says which one.
            latest = {}
            for entry in unresolved:
                name = entry.get("name")
                if name not in latest or (entry.get("pass") or 0) >= (latest[name].get("pass") or 0):
                    latest[name] = entry
            out.append("## Types non résolus\n")
            out.append("| nom | passe | fait | fournisseur | suivi git | demandé par |")
            out.append("|---|---|---|---|---|---|")
            for name in sorted(latest):
                entry = latest[name]
                out.append(f"| {name} | {entry.get('pass', '')} | {entry.get('kind')} |"
                           f" {entry.get('provider', '')} | {entry.get('tracked', '')} |"
                           f" {entry.get('requested_by', '')} |")
            out.append("")

        out.append("## Vérifications faites en dehors du doctor\n")
        out.append("_À compléter par qui restitue le run : toute commande lancée à côté de l'outil"
                   " (`find`, `git`, second diagnostic) avec son résultat. Chacune désigne un fait"
                   " que le snapshot devrait porter._\n")

        if self.bulk:
            out.append("## Sorties brutes\n")
            for title, text in self.bulk:
                out.append(f"### {title}\n")
                out.append("```")
                out.append(text.rstrip())
                out.append("```\n")

        out.append("---\n")
        out.append(f"Enregistrements structurés : `{os.path.basename(self.jsonl_path)}`"
                   f" ({len(self.records)} ligne(s)).")
        return "\n".join(out) + "\n"

    def _all(self, record):
        return [r for r in self.records if r.get("record") == record]

    def _first(self, record):
        found = self._all(record)
        return found[-1] if found else None


class Ctx:
    """Everything a pass needs: where to call, how loudly to report, which pass."""

    def __init__(self, config_path, severity, report, out=None, all_facts=False):
        self.config_path = config_path
        self.severity = severity
        self.report = report
        self.out = out                  # a Report, or None — the ONLY way a file is written
        self.all_facts = all_facts
        self.pass_no = 0
        self.repo_root = None
        self.disk = {}
        # (fact, remedy, target) triples proven no-effect THIS run. Memory across passes
        # of one repair_loop only — a run is never replayed to compare against another.
        self.no_effect_memory = set()
        # Projects remove_projects refused, and projects it actually removed. Same
        # per-run memory: a guard fires on disk content, which no pass of this run
        # changes, so re-asking is re-asking for the same no. Without this, release/5.6
        # replayed the same 10 refusals at all 3 passes — and since the tool is
        # all-or-nothing, those 10 also blocked the 20 removals that were fine.
        self.remove_refused = set()
        self.removed = set()
        # package -> provider project names, from Export-Package on disk manifests.
        # Built once, lazily, the first pass that actually needs it (lot E4).
        self.export_index = None
        # Projects explicitly asked open/closed THIS run (--open/--close/--open-group/
        # --close-group/--focus, applied before the first snapshot — see
        # run_workspace_shape). protected_closed grows across passes: whatever gets
        # closed to keep one of these projects closed is protected in turn, so an
        # orphaned chain converges instead of bouncing between closing and reopening.
        self.protected_open = set()
        self.protected_closed = set()

    def call(self, tool, args, phase=None):
        with Heartbeat(phase or tool):
            start = time.monotonic()
            text, is_error = mcp.call(self.config_path, tool, args)
        if self.report:
            emit("timing", pass_no=self.pass_no, tool=tool,
                 ms=f"{(time.monotonic() - start) * 1000:.0f}")
        return text, is_error


_QUIET = False
_RECORDER = None


class quiet:
    """Suppress traceability lines. Used when a plan is computed only to compare it
    with the previous one — the real pass prints its own decisions."""

    def __enter__(self):
        global _QUIET
        _QUIET = True

    def __exit__(self, *exc):
        global _QUIET
        _QUIET = False
        return False


def emit(record, /, **fields):
    """One traceability line: [doctor:<record>] key=value … — human-readable in the
    terminal, trivially greppable, and re-parsable by whoever reads the run later.
    When a report file is asked for, the same record goes to the .jsonl untouched.

    The record name is positional-only, and the .jsonl calls it `record` rather than
    `kind`: a field named `kind` is exactly what [doctor:unresolved] carries."""
    if _QUIET:
        return
    clean = {}
    for key, value in fields.items():
        if value is None or value == "":
            continue
        clean["pass" if key == "pass_no" else key] = value
    if _RECORDER is not None:
        _RECORDER.record({"record": record, **clean})
    parts = []
    for key, value in clean.items():
        text = "true" if value is True else "false" if value is False else str(value)
        parts.append(f'{key}="{text}"' if " " in text else f"{key}={text}")
    print(f"[doctor:{record}] " + " ".join(parts), flush=True)


def show(ctx, title, text, head=12):
    """Bulk output: everything to the report file if there is one, a head to the
    terminal. Without --report-out the behaviour is unchanged — full text on stdout."""
    if ctx.out is None:
        print(text)
        return
    ctx.out.section(title, text)
    lines = text.splitlines()
    for line in lines[:head]:
        print(line)
    if len(lines) > head:
        print(f"… {len(lines) - head} more line(s) → {ctx.out.md_path}")


def message_shape(message):
    """The shape of a message, not its content: quoted identifiers, dotted names and
    numbers replaced. This is what makes two runs comparable and what reveals a
    missing classifier."""
    shape = message or ""
    for pattern in SHAPE_QUOTED_RES:
        shape = pattern.sub("<X>", shape)
    shape = SHAPE_DOTTED_RE.sub("<X>", shape)
    shape = SHAPE_NUMBER_RE.sub("N", shape)
    return " ".join(shape.split())[:120]


# --- disk facts PDE cannot supply -----------------------------------------


def project_name_on_disk(dot_project):
    try:
        root = ET.parse(dot_project).getroot()
    except (ET.ParseError, OSError):
        return None
    name = root.find("name")
    return name.text.strip() if name is not None and name.text else None


def scan_disk_projects(repo_root):
    """project name -> directory, for every .project on disk. Answers the two
    questions PDE cannot: is an unknown bundle on disk at all (import) or nowhere
    (target platform), and where are its declared source folders."""
    out = {}
    if not repo_root or not os.path.isdir(repo_root):
        return out
    for dirpath, dirnames, filenames in os.walk(repo_root):
        dirnames[:] = [d for d in dirnames if d not in SKIP_DIRS]
        if ".project" not in filenames:
            continue
        # One .project per Eclipse project: do not descend further.
        dirnames[:] = []
        name = project_name_on_disk(os.path.join(dirpath, ".project"))
        if name:
            out[name] = dirpath
    return out


def source_folders(project_dir):
    """(declared, generated, missing) kind="src" entries of a .classpath, relative
    paths. 'generated' is name-based on purpose: it is the only IDE-language-free
    way to say "nobody writes here by hand"."""
    classpath = os.path.join(project_dir, ".classpath") if project_dir else None
    if not classpath or not os.path.isfile(classpath):
        return [], [], []
    try:
        tree = ET.parse(classpath)
    except ET.ParseError:
        return [], [], []
    declared, generated, missing = [], [], []
    for entry in tree.getroot().findall("classpathentry"):
        if entry.get("kind") != "src":
            continue
        path = entry.get("path")
        if not path or path.startswith("/"):
            continue
        path = path.rstrip("/")
        declared.append(path)
        if GENERATED_HINT in os.path.basename(path).lower():
            generated.append(path)
        full = os.path.join(project_dir, path)
        if not os.path.isdir(full) or not os.listdir(full):
            missing.append(path)
    return declared, generated, missing


def newest_mtime(project_dir, relative_paths):
    """Newest mtime under the given relative paths (file or directory). 0.0 when
    nothing exists there — a missing side never claims to be the fresher one."""
    newest = 0.0
    for rel in relative_paths:
        full = os.path.join(project_dir, rel)
        if os.path.isfile(full):
            newest = max(newest, os.path.getmtime(full))
            continue
        if not os.path.isdir(full):
            continue
        for dirpath, dirnames, filenames in os.walk(full):
            dirnames[:] = [d for d in dirnames if d not in SKIP_DIRS]
            for filename in filenames:
                try:
                    newest = max(newest, os.path.getmtime(os.path.join(dirpath, filename)))
                except OSError:
                    pass
    return newest


