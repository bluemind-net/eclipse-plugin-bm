# --- the snapshot ---------------------------------------------------------


class Snapshot:
    """One pass's worth of facts, indexed. Nothing here is a verdict."""

    def __init__(self, data):
        self.raw = data
        self.workspace = data.get("workspace") or {}
        problems = data.get("problems") or {}
        self.error_count = problems.get("errors", 0)
        self.warning_count = problems.get("warnings", 0)
        self.projects = {p["name"]: p for p in data.get("projects") or []}
        self.bundles = {b["name"]: b for b in data.get("bundles") or [] if b.get("name")}
        self.unknown_bundles = set(data.get("unknownBundles") or [])
        self.bundle_by_project = {b["project"]: b for b in self.bundles.values() if b.get("project")}
        # Whether the workspace was actually quiet when the markers were read. Used to be
        # a manual counter-check after the fact; it is a field of the snapshot now.
        self.settled = data.get("settled")
        self.settle_rounds = data.get("settleRounds")
        # name -> {kind, jdtProjects, diskProjects, diskPath, tracked, requestedBy}
        self.unresolved_types = {t["name"]: t for t in data.get("unresolvedTypes") or []
                                 if t.get("name")}
        self.unresolved_truncated = bool(data.get("unresolvedTypesTruncated"))

        self.markers = defaultdict(list)
        for marker in problems.get("markers") or []:
            project = marker.get("project") or marker.get("path", "").lstrip("/").split("/")[0]
            self.markers[project].append(marker)

    def errors_by_project(self):
        return {name: info.get("errors", 0) for name, info in self.projects.items()}

    def errored_projects(self):
        out = {}
        for project, markers in self.markers.items():
            errors = [m for m in markers if str(m.get("severity")) == "error"]
            if errors:
                out[project] = errors
        return out

    def bundle_of(self, project):
        return self.bundle_by_project.get(project) or self.bundles.get(project)


def read_snapshot(ctx, extra_bundles=None):
    args = {"severity": ctx.severity, "waitForBuild": True}
    if extra_bundles:
        args["bundles"] = sorted(extra_bundles)
    text, _ = ctx.call("doctor_snapshot", args, phase="doctor_snapshot (waiting for build)")
    data = mcp.extract_json_block(text)
    if data is None:
        mcp.die("no json block found in doctor_snapshot report")
    return Snapshot(data)


