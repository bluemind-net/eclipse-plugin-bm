# Shape normalisation for hand-off lines: two runs are only comparable if the variable
# parts of a message are replaced by placeholders.
SHAPE_QUOTED_RES = (
    re.compile(r"'[^']{1,80}'"),
    re.compile(r'"[^"]{1,80}"'),
    re.compile(r"`[^`]{1,80}`"),
    re.compile(r"[‘“][^’”]{1,80}[’”]"),
)
SHAPE_DOTTED_RE = re.compile(r"\b[A-Za-z_][\w]*(?:\.[A-Za-z_][\w]*){2,}\b")
SHAPE_NUMBER_RE = re.compile(r"\b\d+\b")

