#!/usr/bin/env python3
"""bm-classpath-check — find Eclipse projects whose declared source folders are missing/empty on disk.

Pure filesystem check (no MCP call): parses each project's .classpath for
<classpathentry kind="src" path="..."> entries and reports any that don't
exist or are empty on disk — typically generated sources not yet built
(codegen via Maven, not Eclipse's builder).

Usage:
  bm-classpath-check --all [--repo PATH]
  bm-classpath-check <project> [<project> ...] [--repo PATH]
"""
import argparse
import os
import sys
import xml.etree.ElementTree as ET

SKIP_DIRS = {".git", "node_modules", "target", "bin", ".metadata"}


def find_repo_root(start):
    """Walk up from start looking for global/pom.xml (mirrors PomPropertyReader)."""
    current = os.path.abspath(start)
    while True:
        if os.path.isfile(os.path.join(current, "global", "pom.xml")):
            return current
        parent = os.path.dirname(current)
        if parent == current:
            return None
        current = parent


def project_name(dot_project_path):
    try:
        el = ET.parse(dot_project_path).getroot().find("name")
        return el.text.strip() if el is not None and el.text else None
    except ET.ParseError:
        return None


def find_projects(repo, wanted):
    """Map project name -> project dir, by scanning for .project files."""
    found = {}
    for dirpath, dirnames, filenames in os.walk(repo):
        dirnames[:] = [d for d in dirnames if d not in SKIP_DIRS]
        if ".project" in filenames:
            name = project_name(os.path.join(dirpath, ".project"))
            if name and (wanted is None or name in wanted):
                found[name] = dirpath
            dirnames[:] = []  # one .project per Eclipse project, don't descend further
    return found


def missing_source_folders(project_dir):
    classpath = os.path.join(project_dir, ".classpath")
    if not os.path.isfile(classpath):
        return []
    try:
        tree = ET.parse(classpath)
    except ET.ParseError:
        return []
    missing = []
    for entry in tree.getroot().findall("classpathentry"):
        if entry.get("kind") != "src":
            continue
        path = entry.get("path")
        if not path or path.startswith("/"):
            continue  # a dependency on another project, not a folder on disk
        full = os.path.join(project_dir, path)
        if not os.path.isdir(full) or not os.listdir(full):
            missing.append(path)
    return missing


def main():
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("projects", nargs="*", help="Project names to check")
    ap.add_argument("--all", action="store_true", help="Check every project found under --repo")
    ap.add_argument("--repo", help="BlueMind repo root (default: derived from cwd)")
    args = ap.parse_args()

    if not args.all and not args.projects:
        ap.error("give project names or --all")

    repo = args.repo or find_repo_root(os.getcwd())
    if not repo:
        ap.error("could not derive the repo root; pass --repo")

    wanted = None if args.all else set(args.projects)
    projects = find_projects(repo, wanted)
    if wanted:
        for name in sorted(wanted - set(projects)):
            print(f"warning: project not found under {repo}: {name}", file=sys.stderr)

    any_missing = False
    for name in sorted(projects):
        missing = missing_source_folders(projects[name])
        if missing:
            any_missing = True
            print(f"{name}:")
            for path in missing:
                print(f"  missing/empty: {path}")

    if not any_missing:
        print("No missing/empty source folders found.")
    return 1 if any_missing else 0


if __name__ == "__main__":
    sys.exit(main())
